# Copy to `.env` (gitignored) and adjust as needed. `docker compose` loads
# this automatically. `./scripts/bootstrap_stalwart.sh` will create `.env`
# with a random STALWART_ADMIN_PASSWORD for you if it's missing, and fills
# in STALWART_JMAP_USER/STALWART_JMAP_PASSWORD once it finishes.

# Recovery-admin login for the Stalwart container (see docker-compose.yml).
# Any value works; the bootstrap script generates one if this file doesn't
# exist yet. Only meaningful before the mail server is torn down with
# `docker compose down -v`.
STALWART_ADMIN_PASSWORD=

# Domain the mail server serves and the app's Space addresses live under.
STALWART_DOMAIN=m4w.local

# Written by ./scripts/bootstrap_stalwart.sh — the JMAP account/app-password
# M4w.Mail.StalwartPoller uses to read the mailbox. Leave blank until then.
STALWART_JMAP_USER=
STALWART_JMAP_PASSWORD=

# API keys used by M4w.Design.Providers.Anthropic / .OpenAI to design a
# Space's pipeline (rooms/doors/keys/entities/artifacts/passages) from a
# goal. Leave both blank to use the free M4w.Design.Providers.Stub instead —
# the design feature never calls a paid API unless one of these is set.
# If both are set, Anthropic wins unless DESIGN_PROVIDER overrides it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Forces a specific provider ("anthropic" | "openai" | "stub") instead of
# auto-selecting from the keys above. Useful to switch providers without
# clearing the other's key, e.g. when one account is out of credit.
DESIGN_PROVIDER=

# Model used for space design generation. Cheaper than claude-opus-5/gpt-5
# reasoning variants since this is a structured-generation task, not
# agentic coding — see feature/design-phase.md for the cost tradeoff.
# Defaults to claude-sonnet-5 or gpt-5 depending on which provider is active.
DESIGN_MODEL=
